generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  photos    Photo[]
  albums    Album[]
  createdAt DateTime @default(now())
}

model Location {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  photos    Photo[]
  albums    Album[]
  createdAt DateTime @default(now())
}

model Photo {
  id           String     @id @default(cuid())
  title        String?
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  locationId   String?
  location     Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  cameraMake      String?
  cameraModel     String?
  iso             String?
  aperture        String?
  shutterSpeed    String?
  focalLength     String?
  exposureMode    String?
  meteringMode    String?
  flash           String?
  takenAt         DateTime?
  r2Key        String     @unique
  r2Url        String
  r2ThumbKey   String?    @unique
  r2ThumbUrl   String?
  width        Int
  height       Int
  // Display-order key: takenAt when known, else createdAt (upload time) as fallback.
  // Kept in sync on create/update — see src/lib/photo-sort-date.ts.
  sortDate     DateTime
  albumId      String?
  album        Album?     @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: SetNull)
  albumCover   Album[]    @relation("AlbumCover")
  tags         PhotoTag[]
  createdAt    DateTime   @default(now())

  @@index([sortDate])
}

model Album {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  isPrivate    Boolean           @default(false)
  categoryId   String?
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  coverPhotoId String?
  coverPhoto   Photo?            @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos       Photo[]           @relation("AlbumPhotos")
  accessCodes  AlbumAccessCode[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model AlbumAccessCode {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  code      String
  /// Who this code was handed to, so it can be revoked by name. Admin-only.
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Tag {
  id     String     @id @default(cuid())
  name   String     @unique
  slug   String     @unique
  photos PhotoTag[]
}

model PhotoTag {
  photoId String
  tagId   String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
}

/// Fixed-window counter used to throttle access-code attempts.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
}
